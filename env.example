# Copy to .env for local overrides. Do not commit real credentials.
#
# Vite exposes every VITE_* value to browser code. Never put private provider
# keys, service-account credentials, or other secrets in VITE_* variables.

# ---------------------------------------------------------------------------
# Firebase web configuration
# ---------------------------------------------------------------------------
# The app currently has defaults for its Firebase project. Set these only to
# override the project configuration for local development or another project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Functions base URL. If unset, the app derives it from the region and
# Firebase project ID.
VITE_FIREBASE_FUNCTIONS_URL=
VITE_FIREBASE_REGION=us-central1

# ---------------------------------------------------------------------------
# Optional client feature configuration
# ---------------------------------------------------------------------------
# VITE_ENTERPRISE_MODE=false
# VITE_ENTERPRISE_DOMAINS=example.com,example.org
# VITE_ENABLE_LOCATION_TRACKING=0
# VITE_ENABLE_PROACTIVE_AI=0
# VITE_TWILIO_WHATSAPP_NUMBER=
# VITE_PROMO_BANNER_TEXT=
# VITE_PROMO_BANNER_CODE=
# VITE_PROMO_BANNER_ENDS=

# ---------------------------------------------------------------------------
# Legacy/optional Supabase client configuration
# ---------------------------------------------------------------------------
# Firebase is the primary backend for the app-facing backend client. These
# values are read by the separate Supabase integration when that client is
# used.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-side AI provider configuration
# ---------------------------------------------------------------------------
# Configure the shared provider credential as a Firebase Functions secret,
# not here: firebase functions:secrets:set OPENROUTER_API_KEY
#
# Do not set VITE_GROQ_API_KEY or VITE_OPENAI_API_KEY for production: Vite
# embeds VITE_* values in client bundles, making them visible to users.
